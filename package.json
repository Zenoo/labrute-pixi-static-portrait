{
  "name": "labrute-pixi-static-portrait",
  "version": "1.0.6",
  "description": "Static LaBrute character portraits for caller-owned PixiJS 8 renderers.",
  "main": "dist/Symbols.js",
  "module": "dist/Symbols.mjs",
  "types": "dist/Symbols.d.ts",
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "npm run test:unit",
    "playground": "webpack serve --mode development",
    "setup:swf": "node scripts/setup-swf.cjs",
    "export:swf": "node scripts/export-swf.cjs",
    "test:unit": "node --test test/*.test.cjs test/*.test.mjs",
    "test:browser": "node test/browser.cjs",
    "test:comparison": "node test/browser.cjs comparison",
    "benchmark": "node test/browser.cjs benchmark",
    "test:generation": "node scripts/check-generation.cjs",
    "prepublishOnly": "npm run build && npm run test:unit",
    "deploy": "npm publish",
    "test:playground": "node test/browser.cjs playground",
    "test:packaging": "node --test test/packaging.test.cjs",
    "format": "prettier --write \"src/*.ts\" \"scripts/**/*.cjs\" \"test/**/*.{cjs,mjs,html}\" \"*.mjs\" \"webpack.config.js\" \"package.json\" \".prettierrc.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/*.ts\" \"scripts/**/*.cjs\" \"test/**/*.{cjs,mjs,html}\" \"*.mjs\" \"webpack.config.js\" \"package.json\" \".prettierrc.json\" \".github/workflows/*.yml\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zenoo/labrute-pixi-static-portrait.git"
  },
  "bugs": {
    "url": "https://github.com/Zenoo/labrute-pixi-static-portrait/issues"
  },
  "homepage": "https://github.com/Zenoo/labrute-pixi-static-portrait#readme",
  "keywords": [
    "labrute",
    "mybrute",
    "pixi",
    "portrait",
    "static",
    "swf"
  ],
  "author": "Zenoo",
  "license": "MIT",
  "devDependencies": {
    "@ruffle-rs/ruffle": "0.7.1",
    "html-webpack-plugin": "^5.5.0",
    "pixi.js": "^8.19.0",
    "prettier": "3.1.0",
    "rollup": "^4.2.0",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "terser": "5.31.6",
    "typescript": "^4.6.3",
    "webpack": "^5.65.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/Symbols.d.mts",
        "default": "./dist/Symbols.mjs"
      },
      "require": {
        "types": "./dist/Symbols.d.cts",
        "default": "./dist/Symbols.js"
      }
    },
    "./dist/Symbols.js": {
      "types": "./dist/Symbols.d.cts",
      "default": "./dist/Symbols.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/Symbols.js",
    "dist/Symbols.mjs",
    "dist/symbol-data.cjs",
    "dist/Symbols.d.ts",
    "dist/Symbols.d.cts",
    "dist/Symbols.d.mts",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "pixi.js": "^8.19.0"
  },
  "dependencies": {
    "pixi-filters": "^6.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
